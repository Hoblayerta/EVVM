# Private key para deployment (SIN 0x al inicio)
PRIVATE_KEY=your_private_key_here

# RPC URL de Sepolia
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Etherscan API Key para verificación
ETHERSCAN_API_KEY=your_etherscan_api_key

# Direcciones de EVVMs deployados
EVVM_A_ADDRESS=0x...
EVVM_B_ADDRESS=0x...

# Principal Tokens
PRINCIPAL_TOKEN_A=0x...
PRINCIPAL_TOKEN_B=0x...
